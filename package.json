{
  "name": "binp-git-graph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bunx concurrently -k -n server,client \"bun --watch server/index.ts\" \"bunx vite\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:client": "bunx vite",
    "build": "bunx vite build && NODE_ENV=production bun build server/index.ts --outdir dist/server --target bun --sourcemap=linked --production",
    "start": "NODE_ENV=production bun dist/server/index.js",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "@tabler/icons-react": "^3.44.0",
    "elysia": "^1.4.28",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.0",
    "typescript": "^5.7",
    "vite": "^8.0.9"
  }
}
